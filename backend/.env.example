# CCTV Official Endpoints
CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
RTSP_BASE_URL=rtsp://103.250.160.189:8554/stream
WHEP_BASE_URL=http://103.250.160.189:8889/stream
HLS_BASE_URL=https://cctv.corp8.cloud

# Sentinel Portal Auth Credentials
SENTINEL_EMAIL=your_email@domain.com
SENTINEL_PASSWORD=YOUR-ACCESS-PASSWORD

# Server Config
HOST=127.0.0.1
PORT=8000

# YOLO Live Vehicle Detection Config (Phase 5 & 6)
YOLO_MODEL_NAME=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_FRAME_INTERVAL=5
# Suppress overlapping car/bus/truck boxes before assigning tracker IDs.
YOLO_AGNOSTIC_NMS=true
YOLO_DEVICE=auto
YOLO_TRACKER=bytetrack.yaml
TRACK_INACTIVE_TIMEOUT_SECONDS=10.0

# Fetch only after configuring your authorized organizer credentials.
FETCH_CATALOGUE_ON_START=false
AI_ENABLED=true
# Bound decoder/analytics workers; increase only after measuring the target machine.
MAX_ACTIVE_CAMERAS=2
ALLOW_MODEL_DOWNLOAD=false
YOLO_IMAGE_SIZE=640

# Optional roles for network deployment; use strong unique secrets.
# CCTV_ADMIN_PASSWORD=
# CCTV_OPERATOR_PASSWORD=
# CCTV_VIEWER_PASSWORD=
# Path variables below are process environment variables (set before launch).
# CCTV_MEDIA_DIR=E:/gujarat police/repo/scratch
# CCTV_DATA_DIR=E:/gujarat police/repo/data
# CCTV_DB_PATH=E:/gujarat police/repo/cctv_surveillance.db

# Default validation stays Indian. Explicit overrides for licensed foreign samples only.
ANPR_CAMERA_FORMATS={}
# Example: {"PUBLIC-CARPARK":"FINLAND_STANDARD"}

# Optional plate OCR must be installed and evaluated before selection.
ANPR_OCR_ENGINE=easyocr
PLATE_OCR_MIN_CHAR_CONFIDENCE=0.90
# Bound transient recognition state; confirmed history remains in the database.
ANPR_MAX_CACHED_TRACKS=1000
ANPR_MAX_CANDIDATES_PER_TRACK=5
